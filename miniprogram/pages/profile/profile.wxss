.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  margin: 30rpx 30rpx 0;
  padding: 40rpx 30rpx;
  background: #4CAF50;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background: #e0e0e0;
}

.user-text {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.family-name {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.user-card .arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.8;
}

.menu-list {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 30rpx;
  color: #333;
}

.menu-item .arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.4;
}

.logout-btn {
  margin: 60rpx 30rpx 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.logout-btn text {
  font-size: 30rpx;
  color: #e53935;
}
