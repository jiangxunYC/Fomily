.page {
  min-height: 100vh;
  background: #FAF9F7;
  padding: 24rpx;
}

.section {
  background: rgba(213, 227, 214, 0.3);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #556257;
  margin-bottom: 16rpx;
}

.family-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.family-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #1A1C1B;
}

.name-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  color: #1A1C1B;
  border-bottom: 2rpx solid #426446;
  padding-bottom: 8rpx;
}

.edit-icon {
  font-size: 32rpx;
  color: #426446;
  padding: 10rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #426446;
  letter-spacing: 8rpx;
}

.btn-copy {
  background: #426446;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(194, 200, 191, 0.3);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #1A1C1B;
}

.arrow {
  font-size: 36rpx;
  color: #556257;
}

.danger-btn-wrap {
  margin-top: 32rpx;
}

.btn-disband {
  background: rgba(213, 227, 214, 0.3);
  color: #e57373;
  border: 1rpx solid #e57373;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
