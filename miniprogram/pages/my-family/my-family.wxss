.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.family-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.family-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.name-input {
  flex: 1;
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
  border-bottom: 2rpx solid #4CAF50;
  padding-bottom: 8rpx;
}

.edit-icon {
  font-size: 32rpx;
  color: #4CAF50;
  padding: 10rpx;
}

.invite-code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  letter-spacing: 8rpx;
}

.btn-copy {
  background: #4CAF50;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

.danger-btn-wrap {
  margin-top: 32rpx;
}

.btn-disband {
  background: #fff;
  color: #f44336;
  border: 1rpx solid #f44336;
  border-radius: 12rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
