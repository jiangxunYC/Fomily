.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.type-selector {
  display: flex;
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
}

.type-item.active {
  background: #4CAF50;
  color: #fff;
  font-weight: 600;
}

.form-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  border-bottom: 2rpx solid #eee;
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #333;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  border-bottom: 2rpx solid #eee;
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #333;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #eee;
  display: block;
}

.picker-text.placeholder {
  color: #bbb;
}

.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.upload-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 56rpx;
  color: #ccc;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn-save {
  background: #4CAF50;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
