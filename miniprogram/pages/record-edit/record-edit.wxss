.page {
  background: #FAF9F7;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.type-selector {
  display: flex;
  margin: 24rpx;
  background: rgba(213, 227, 214, 0.3);
  border-radius: 16rpx;
  overflow: hidden;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #424841;
}

.type-item.active {
  background: #426446;
  color: #fff;
  font-weight: 600;
}

.form-card {
  background: rgba(213, 227, 214, 0.3);
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #424841;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  border-bottom: 2rpx solid rgba(194, 200, 191, 0.3);
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #1A1C1B;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  border-bottom: 2rpx solid rgba(194, 200, 191, 0.3);
  padding: 12rpx 0;
  font-size: 30rpx;
  color: #1A1C1B;
}

.picker-text {
  font-size: 30rpx;
  color: #1A1C1B;
  padding: 12rpx 0;
  border-bottom: 2rpx solid rgba(194, 200, 191, 0.3);
  display: block;
}

.picker-text.placeholder {
  color: #556257;
}

.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.upload-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
}

.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(194, 200, 191, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus {
  font-size: 56rpx;
  color: #556257;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(213, 227, 214, 0.3);
  box-shadow: 0 -2rpx 10rpx rgba(66, 100, 70, 0.08);
}

.btn-save {
  background: #426446;
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
}
