<view class="page">
  <view class="form-card">
    <view class="form-item avatar-item" bindtap="onChangeAvatar">
      <text class="form-label">头像</text>
      <image class="avatar" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
    </view>
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input class="form-input" value="{{nickname}}" bindinput="onInputNickname" placeholder="请输入昵称"/>
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" value="{{phone}}" bindinput="onInputPhone" placeholder="请输入手机号"/>
    </view>
    <view class="form-item">
      <text class="form-label">家庭名称</text>
      <text class="form-value readonly">{{familyName}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">家庭角色</text>
      <view class="role-display">
        <text class="role-badge role-{{role}}">{{roleLabel}}</text>
      </view>
    </view>
  </view>

  <view class="btn-area">
    <button class="btn-save" bindtap="onSave">保存</button>
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>
