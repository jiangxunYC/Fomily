.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 240rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 160rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.form-value {
  font-size: 28rpx;
  color: #333;
}

.form-value.readonly {
  color: #999;
}

.avatar-item {
  padding: 20rpx 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.role-display {
  display: flex;
  align-items: center;
}

.role-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
}

.role-owner { background: #4CAF50; }
.role-editor { background: #FF9800; }
.role-viewer { background: #9E9E9E; }

.btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 48rpx;
  background: #f5f5f5;
}

.btn-save {
  background: #4CAF50;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 20rpx;
}

.btn-logout {
  background: #fff;
  color: #f44336;
  border-radius: 16rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
