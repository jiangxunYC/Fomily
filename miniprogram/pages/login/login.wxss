.page {
  min-height: 100vh;
  background: #FAF9F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  width: 100%;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #426446;
  margin-bottom: 8rpx;
}

.slogan {
  font-size: 26rpx;
  color: #556257;
  margin-bottom: 64rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #426446;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
  padding: 0;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: transparent;
  color: #426446;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid #426446;
  border-radius: 16rpx;
  text-align: center;
  padding: 0;
}

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 600rpx;
  background: #FAF9F7;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx rgba(66, 100, 70, 0.1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1C1B;
  margin-bottom: 36rpx;
}

.modal-input {
  width: 100%;
  border: 2rpx solid rgba(194, 200, 191, 0.5);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 36rpx;
  color: #1A1C1B;
}

.modal-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #426446;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  text-align: center;
  padding: 0;
}
