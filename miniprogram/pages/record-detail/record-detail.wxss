.page {
  background: #FAF9F7;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.header {
  background: rgba(213, 227, 214, 0.3);
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1C1B;
}

.type-badge {
  background: rgba(213, 227, 214, 0.3);
  color: #426446;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.record-date {
  font-size: 26rpx;
  color: #556257;
  margin-top: 12rpx;
}

.detail-card {
  background: rgba(213, 227, 214, 0.3);
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}

.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 24rpx;
  color: #556257;
  margin-bottom: 8rpx;
}

.field-value {
  font-size: 30rpx;
  color: #1A1C1B;
}

.attachments {
  margin: 0 24rpx;
  background: rgba(213, 227, 214, 0.3);
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  color: #1A1C1B;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(213, 227, 214, 0.3);
  box-shadow: 0 -2rpx 10rpx rgba(66, 100, 70, 0.08);
  gap: 24rpx;
}

.btn-edit {
  flex: 1;
  background: #426446;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-delete {
  flex: 1;
  background: rgba(213, 227, 214, 0.3);
  color: #e57373;
  border: 2rpx solid #e57373;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}
