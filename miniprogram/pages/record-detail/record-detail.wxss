.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.header {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.type-badge {
  background: #E8F5E9;
  color: #4CAF50;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.record-date {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
}

.detail-card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
}

.field {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.field-value {
  font-size: 30rpx;
  color: #333;
}

.attachments {
  margin: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  gap: 24rpx;
}

.btn-edit {
  flex: 1;
  background: #4CAF50;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.btn-delete {
  flex: 1;
  background: #fff;
  color: #e53935;
  border: 2rpx solid #e53935;
  border-radius: 16rpx;
  font-size: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
}
