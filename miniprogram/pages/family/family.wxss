.page {
  min-height: 100vh;
  background: #FAF9F7;
  padding-bottom: 120rpx;
}

/* 登录引导 */
.login-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 60rpx 40rpx;
}

.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(213, 227, 214, 0.3);
  border-radius: 16rpx;
  padding: 80rpx 60rpx;
  width: 100%;
}

.banner-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(213, 227, 214, 0.4);
  border-radius: 50%;
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(213, 227, 214, 0.4);
  border-radius: 50%;
  font-size: 64rpx;
  margin-bottom: 24rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1C1B;
  margin-bottom: 16rpx;
}

.banner-desc {
  font-size: 28rpx;
  color: #556257;
  margin-bottom: 48rpx;
}

.banner-btn {
  background: #426446;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  padding: 20rpx 80rpx;
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #556257;
  margin-bottom: 48rpx;
}

.add-first-btn {
  background: #426446;
  color: #fff;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 20rpx 60rpx;
  border: none;
}

/* 成员横向滚动 */
.member-tabs {
  white-space: nowrap;
  background: rgba(213, 227, 214, 0.3);
  padding: 24rpx 16rpx;
}

.member-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
}

.member-tab.active {
  background: rgba(213, 227, 214, 0.3);
}

.member-tab.active .tab-name {
  color: #426446;
  font-weight: 600;
}

.tab-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 8rpx;
  border: 4rpx solid transparent;
}

.member-tab.active .tab-avatar {
  border-color: #426446;
}

.tab-name {
  font-size: 24rpx;
  color: #424841;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 成员卡片 */
.member-card {
  display: flex;
  align-items: center;
  background: rgba(213, 227, 214, 0.3);
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(66, 100, 70, 0.04);
}

.card-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  overflow: hidden;
}

.card-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1C1B;
  margin-right: 16rpx;
}

.card-relation {
  font-size: 24rpx;
  color: #426446;
  background: rgba(213, 227, 214, 0.3);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-meta {
  font-size: 26rpx;
  color: #556257;
}

.card-meta text {
  margin-right: 20rpx;
}

.card-bound {
  color: #426446;
}

.card-unbound {
  color: #556257;
}

.card-arrow {
  font-size: 40rpx;
  color: #556257;
  flex-shrink: 0;
}

/* 记录列表 */
.record-section {
  margin: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.select-count {
  font-size: 28rpx;
  color: #424841;
  flex: 1;
}

.cancel-select {
  font-size: 28rpx;
  color: #556257;
  margin-right: 32rpx;
}

.batch-delete {
  font-size: 28rpx;
  color: #e57373;
}

.empty-record {
  text-align: center;
  padding: 80rpx 0;
  color: #556257;
  font-size: 28rpx;
}

.record-item {
  display: flex;
  align-items: center;
  background: rgba(213, 227, 214, 0.3);
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.record-item.selected {
  background: rgba(213, 227, 214, 0.15);
}

.record-check {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #556257;
  border-radius: 50%;
}

.check-box.checked {
  background: #426446;
  border-color: #426446;
}

.record-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.record-badge-medical {
  background: rgba(213, 227, 214, 0.4);
  color: #426446;
}

.record-badge-vaccine {
  background: rgba(171, 208, 171, 0.2);
  color: #75562C;
}

.record-badge-insurance {
  background: rgba(213, 227, 214, 0.4);
  color: #426446;
}

.record-body {
  flex: 1;
  overflow: hidden;
}

.record-summary {
  font-size: 28rpx;
  color: #1A1C1B;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-date {
  font-size: 24rpx;
  color: #556257;
  margin-top: 6rpx;
  display: block;
}

/* FAB */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: #426446;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(66, 100, 70, 0.4);
}

.fab-icon {
  font-size: 52rpx;
  color: #fff;
  line-height: 1;
}
