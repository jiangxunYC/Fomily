.family-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.family-card-content {
  flex: 1;
}

.family-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1C1B;
  margin-bottom: 8rpx;
}

.family-meta {
  font-size: 26rpx;
  color: #424841;
}

.family-card-arrow {
  font-size: 40rpx;
  color: #556257;
}

.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.medical-icon {
  background: #426446;
}

.vaccine-icon {
  background: #75562C;
}

.insurance-icon {
  background: #ABD0AB;
}

.quick-btn text {
  font-size: 24rpx;
  color: #424841;
}

.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-left: 24rpx;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  position: absolute;
  left: -8rpx;
  top: 32rpx;
}

.timeline-dot.medical {
  background: #426446;
}

.timeline-dot.vaccine {
  background: #75562C;
}

.timeline-dot.insurance {
  background: #ABD0AB;
}

.timeline-body {
  flex: 1;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.timeline-type {
  font-size: 24rpx;
  color: #426446;
  font-weight: 500;
}

.timeline-time {
  font-size: 22rpx;
  color: #556257;
}

.timeline-title {
  font-size: 28rpx;
  color: #1A1C1B;
  margin-bottom: 6rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #556257;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
