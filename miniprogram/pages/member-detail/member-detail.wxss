.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.member-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #4CAF50;
  color: #fff;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.6);
}

.info {
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
}

.relation {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.birthday {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 6rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #4CAF50;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.tab-bar {
  display: flex;
  margin: 24rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #4CAF50;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: #4CAF50;
  border-radius: 2rpx;
}

.record-list {
  margin: 24rpx;
}

.record-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-summary {
  font-size: 30rpx;
  color: #333;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}
