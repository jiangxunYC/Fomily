.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  font-size: 26rpx;
  color: #333;
  background: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.log-list {
  padding: 24rpx;
}

.log-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.actor-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.log-content {
  flex: 1;
}

.log-desc {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: block;
}

.log-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
