.page {
  min-height: 100vh;
  background: #FAF9F7;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(213, 227, 214, 0.3);
  border-bottom: 1rpx solid rgba(194, 200, 191, 0.3);
}

.filter-item {
  font-size: 26rpx;
  color: #1A1C1B;
  background: rgba(213, 227, 214, 0.3);
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
}

.log-list {
  padding: 24rpx;
}

.log-item {
  display: flex;
  align-items: flex-start;
  background: rgba(213, 227, 214, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.actor-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: rgba(194, 200, 191, 0.3);
}

.log-content {
  flex: 1;
}

.log-desc {
  font-size: 28rpx;
  color: #1A1C1B;
  line-height: 1.5;
  display: block;
}

.log-time {
  font-size: 22rpx;
  color: #556257;
  margin-top: 8rpx;
  display: block;
}

.empty-state {
  display: flex;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #556257;
}
