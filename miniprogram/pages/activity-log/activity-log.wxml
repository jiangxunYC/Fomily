<view class="page">
  <view class="filter-bar">
    <picker range="{{memberOptions}}" range-key="label" value="{{memberFilterIndex}}" bindchange="onMemberFilter">
      <view class="filter-item">{{memberOptions[memberFilterIndex].label}} ▾</view>
    </picker>
    <picker range="{{actionOptions}}" range-key="label" value="{{actionFilterIndex}}" bindchange="onActionFilter">
      <view class="filter-item">{{actionOptions[actionFilterIndex].label}} ▾</view>
    </picker>
  </view>

  <view class="log-list" wx:if="{{logs.length > 0}}">
    <view class="log-item" wx:for="{{logs}}" wx:key="_id">
      <image class="actor-avatar" src="{{item.actor_avatar || '/images/default-avatar.png'}}" mode="aspectFill"/>
      <view class="log-content">
        <text class="log-desc">{{item.description}}</text>
        <text class="log-time">{{item.timeLabel}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && logs.length === 0}}">
    <text class="empty-text">暂无操作记录</text>
  </view>
</view>
